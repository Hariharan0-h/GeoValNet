   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"../data/sample_houses.csv\")\n",
    "\n",
    "median_price = (\n",
    "    df.groupby(\"zipcode\")[\"price\"]\n",
    "      .median()\n",
    "      .reset_index()\n",
    ")\n",
    "\n",
    "median_price.head()"
   ]
